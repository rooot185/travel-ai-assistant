# Use a unique password. Never commit a populated .env file.
DATABASE_PASSWORD=
WEB_PORT=8088
# For loopback HTTP development only. Use true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Set true and configure both keys to enable the live planner.
AI_ENABLED=false
MODEL_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=
AMAP_WEB_KEY=
