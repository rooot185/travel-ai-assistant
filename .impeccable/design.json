  "narrative": {
    "northStar": "山水册页",
    "overview": "象牙纸色构成底面，墨绿标题和细线划分阅读区。西湖实景照片给出地域感，日程与路线则借用册页对读的秩序。\n\n信息以清晰的标题、时间、地点和操作排列。重点从文字和间距获得层次，绿色引导操作，朱色标记必去地点和当前关注的站点。",
    "keyCharacteristics": [
      "暖纸底与墨绿色文字",
      "写实地方照片与清晰的行程页",
      "细边线与浅色选中状态",
      "时间表与路线共用站点编号"
    ],
    "rules": [
      {
        "name": "The Route Accent Rule",
        "body": "松绿标出可操作和已选状态。印泥朱标出必去地点和当前关注的站点。",
        "section": "colors"
      },
      {
        "name": "The Aligned Numerals Rule",
        "body": "日期、时刻、距离和金额在需要前后比较的列表里使用等宽数字。",
        "section": "typography"
      }
    ],
    "dos": [
      "保留导航和筛选项的文字标签，让状态同时通过颜色和轮廓或字重表达。",
      "让时间、地点编号、路程和费用按阅读顺序对齐。",
      "让路线图的编号与日程列表同步，并保留文本说明和数据来源。"
    ],
    "donts": [
      "避免给常规内容面板叠加阴影并抬高视觉层级。",
      "避免把封面字体用于表单值、时刻和金额。",
      "避免用印泥朱渲染整片内容面板。"
    ]
  }
}
